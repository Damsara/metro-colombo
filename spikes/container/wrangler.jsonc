{
  "name": "metro-spike-container",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "containers": [{ "class_name": "Compactor", "image": "./image/Dockerfile", "instance_type": "basic", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "COMPACTOR", "class_name": "Compactor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Compactor"] }],
  "triggers": { "crons": ["*/10 * * * *"] }
}
