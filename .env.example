# Copy to `.env` (gitignored) to override any of these.

# Optional. Bearer token for the MetroBus fare-service (stops, journeys) and the
# ticketing-service live fleet feed. Defaults to the reader token shipped in the
# official tracker's public client bundle (lmtgo.eimsky.com), the one that gets
# the real fleet; other tokens may only receive a synthetic live feed. An empty
# value overrides the default, so leave this commented out unless replacing it.
# METRO_API_TOKEN=

# Upstream hosts (defaults shown; override only if needed).
EIMSKY_BASE=https://metrobusapiprod.eimsky.com
LANKAMETRO_BASE=https://lankametro.lk

# API + web server.
HOST=127.0.0.1
PORT=8788
# Vite build served alongside the API (relative to the working directory).
WEB_DIST=web/dist
