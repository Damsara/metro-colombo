# Copy to `.env` (gitignored) to override any of these.

# Required. The upstream refresh token; `node scripts/otp-login.mjs <phone>`
# writes it here. The server renews it on its own from then on.
METRO_REFRESH_TOKEN=

# Where the server keeps the renewed refresh token between restarts.
# AUTH_STATE_PATH=.auth-state

# Optional. Logging in again without a laptop: when the refresh token dies,
# the server texts a code to METRO_PHONE and accepts it at POST /fleet/otp with
# `Authorization: Bearer <OTP_SECRET>` and `{"code":"123456"}`. Without
# OTP_SECRET the endpoint answers 404.
# METRO_PHONE=0712345678
# OTP_SECRET=<openssl rand -hex 24>

# Optional. Alerts when the login dies and when it's restored: plain text
# POSTed here, e.g. an ntfy topic (https://ntfy.sh/<hard-to-guess-topic>).
# ALERT_WEBHOOK_URL=

# Upstream hosts (defaults shown; override only if needed).
EIMSKY_BASE=https://metrobusapiprod.eimsky.com
LANKAMETRO_BASE=https://lankametro.lk

# API + web server.
HOST=127.0.0.1
PORT=8788
# Vite build served alongside the API (relative to the working directory).
WEB_DIST=web/dist

# Optional. Google Analytics 4 measurement id, read when building the UI
# (`npm --prefix web run build` or `docker build --build-arg`). Unset = no analytics.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional. Traces, logs and metrics over OTLP, e.g. to Grafana Cloud. Effect
# sends nothing unless each *_EXPORTER is set to otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instance-id:token>
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
