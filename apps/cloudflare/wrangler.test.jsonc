{
  "name": "metro-staging-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FLEET", "class_name": "FleetObject" },
      { "name": "PROBE", "class_name": "StorageProbe" },
      { "name": "COMPACTOR", "class_name": "Compactor" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FleetObject", "StorageProbe"] },
    { "tag": "v2", "new_sqlite_classes": ["Compactor"] },
  ],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "metro-data-test" }],
  "vars": {
    "LIVE_FEED": "replay",
    "REPLAY_DATE": "2026-10-11",
    "REPLAY_SPEED": "1",
    "FLEET_INSTANCE": "fleet",
    "OTP_SECRET": "test-secret",
    "UPSTREAM": "proxy",
    "UPSTREAM_PROXY_URL": "http://127.0.0.1:9",
    "PUBLIC_DATA_URL": "http://127.0.0.1:9",
    "ARCHIVE_ROOT": "r2://metro-data-test",
  },
}
