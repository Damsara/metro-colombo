{
  "name": "metro-staging-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "StorageProbe" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StorageProbe"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "metro-data-test" }],
  "vars": { "LIVE_FEED": "replay", "REPLAY_DATE": "2026-10-11", "REPLAY_SPEED": "1", "FLEET_INSTANCE": "fleet", "OTP_SECRET": "test-secret" }
}
