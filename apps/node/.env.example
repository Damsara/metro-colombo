# The whole site in one Node process. Copy to apps/node/.env (gitignored); `npm start` reads only that file.

# Live positions: `replay` plays back a recorded day, `lankametro` logs in and follows the real feed.
# Prepare a replay day first: npm --workspace @metro/node run replay:prepare -- --date 2026-10-12 --out .fleet-data
LIVE_FEED=replay
REPLAY_DATE=2026-10-12
# REPLAY_SPEED=1

# Routes, stops and journeys: `proxy` reads them from another instance's /api, `lankametro` from the operator.
UPSTREAM=proxy
UPSTREAM_PROXY_URL=https://metro.manasa.ai

# The DuckDB catalog served at the site root reads catalog/metro.duckdb from here.
PUBLIC_DATA_URL=https://data.metro.manasa.ai

# Logging in (LIVE_FEED=lankametro or UPSTREAM=lankametro). Use your own LMT-GO account: a new login can end
# another server's session on the same account, and refresh tokens work only once. With no session the server texts a code to
# METRO_PHONE and accepts it at POST /fleet/otp with `Authorization: Bearer <OTP_SECRET>` and `{"code":"123456"}`;
# without OTP_SECRET that endpoint answers 404. POST /fleet/login with `{"phone":"0771234567"}` and the same header texts a code
# to another number and keeps it in place of METRO_PHONE. A refresh token you already have can seed the first session.
# METRO_PHONE=0712345678
# OTP_SECRET=<openssl rand -hex 24>
# METRO_REFRESH_TOKEN=
# Alerts when the login dies and when it's restored, POSTed as plain text, e.g. to https://ntfy.sh/<hard-to-guess-topic>.
# ALERT_WEBHOOK_URL=

# Storage: local files under DATA_DIR, or an S3-compatible bucket such as R2 when S3_ENDPOINT is set.
# FLEET_STATE_PATH=.fleet-state.json
# DATA_DIR=.fleet-data
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ARCHIVE_BUCKET=metro-data-staging
# FLEET_INSTANCE=fleet

# Upstream hosts (defaults shown).
# EIMSKY_BASE=https://metrobusapiprod.eimsky.com
# LANKAMETRO_BASE=https://lankametro.lk
# OCCASIONS_ICS_URL=

# Server.
# HOST=127.0.0.1
# PORT=8789
# WEB_DIST=../../web/dist

# Traces, logs and metrics over OTLP, e.g. to Grafana Cloud. Effect sends nothing unless each *_EXPORTER is otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instance-id:token>
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
