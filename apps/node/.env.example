# The Fleet in one process. Copy to apps/node/.env (gitignored); `npm --workspace @metro/node start` reads only that file.
# Phase 2 runs replay only: never set LIVE_FEED=lankametro or METRO_REFRESH_TOKEN here.
LIVE_FEED=replay
REPLAY_DATE=2026-10-12
# REPLAY_SPEED=1
# Prepare the day first: npm --workspace @metro/node run replay:prepare -- --date 2026-10-12 --out .fleet-data
# FLEET_INSTANCE=fleet
# FLEET_STATE_PATH=.fleet-state.json
# DATA_DIR=.fleet-data
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ARCHIVE_BUCKET=metro-data-staging
# OTP_SECRET=
# ALERT_WEBHOOK_URL=https://ntfy.sh/<topic>
# METRO_PHONE=
# HOST=127.0.0.1
# PORT=8789
