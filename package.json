{
  "name": "lmt-go-ui",
  "version": "1.0.0",
  "description": "Colombo bus trip planner and live map for Lanka Metro Transit, with an Effect v4 transit API",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.1",
    "effect": "^4.0.1",
    "undici": "8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
