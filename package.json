{
  "name": "lmt-go-ui",
  "version": "1.0.0",
  "description": "Colombo bus trip planner and live map for Lanka Metro Transit, with an Effect v4 transit API",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*",
    "apps/node"
  ],
  "scripts": {
    "dev": "npm run build:packages && npm --workspace @metro/node run dev",
    "start": "npm run build:packages && npm --workspace @metro/node start",
    "build:packages": "tsc -b packages/core packages/upstream packages/fleet packages/publisher packages/api",
    "typecheck": "npm run build:packages && tsc -p apps/node --noEmit",
    "pretest": "npm run build:packages",
    "test": "node --import tsx --test tests/*.test.ts packages/*/test/*.test.ts apps/node/test/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.1",
    "aws4fetch": "1.0.20",
    "effect": "^4.0.1",
    "undici": "8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
